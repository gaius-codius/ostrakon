{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/.claude-plugin/types", "!tools/experiments", "!tools/mockups", "!tools/gallery"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "single", "semicolons": "asNeeded", "arrowParentheses": "asNeeded", "trailingCommas": "all" }
  },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "assist": { "enabled": false }
}
