{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/.claude-plugin/types", "!server/public/vendor", "!tools/experiments", "!tools/mockups", "!tools/gallery"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "single", "semicolons": "asNeeded", "arrowParentheses": "asNeeded", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["plugin/tests/**", "tools/**/*.test.ts"],
      "linter": { "rules": { "correctness": { "noUnusedFunctionParameters": "off" }, "style": { "noNonNullAssertion": "off" } } }
    }
  ],
  "assist": { "enabled": false }
}
