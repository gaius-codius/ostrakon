#!/usr/bin/env bash
# The ostrakon command line. Install by linking it onto your PATH:
#   ln -sf "$PWD/bin/ostrakon" ~/.local/bin/ostrakon
# HUB_* settings come from the environment, else from ~/.config/ostrakon-hub/env (the systemd
# unit's file, read as KEY=VALUE lines the way systemd reads it, never run as shell).
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
ENV_FILE=${OSTRAKON_HUB_ENV:-$HOME/.config/ostrakon-hub/env}

usage() {
  cat <<EOF
usage: ostrakon <command>

  pair [--token] [url]
               print a QR code that pairs a phone with the hub: a one-time code, good for
               5 minutes (needs the hub running here). --token prints one that carries the
               hub token itself instead. url: the hub's https address, default this
               machine's Tailscale name on port 8443
  jot [--project <name>] <text>
               save a note of yours from outside Claude Code: into this machine's notes, and
               to the hub at once if one is set up. --ask asks for it in a desktop prompt
               (bind that to a key; README)
  hub          run the hub in the foreground
  update       update this checkout (newest release, or pull its branch) and restart the
               hub if it's installed; --release / --main to switch (update.sh)
  doctor       check that everything is set up and working, and say what to fix
  version      show the version and the checkout's commit
  help         show this

HUB_* settings are read from the environment, else from $ENV_FILE.
EOF
}

load_env() {
  [ -r "$ENV_FILE" ] || return 0
  local line key value
  while IFS= read -r line || [ -n "$line" ]; do
    [[ $line =~ ^[[:space:]]*(HUB_[A-Z_]+)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    [[ $value =~ ^\"(.*)\"$ || $value =~ ^\'(.*)\'$ ]] && value=${BASH_REMATCH[1]}
    [ -n "${!key:-}" ] || export "$key=$value"
  done < "$ENV_FILE"
}

need_bun() { command -v bun >/dev/null || { echo "ostrakon: needs Bun (https://bun.sh)" >&2; exit 1; }; }

case ${1:-help} in
  update) shift; exec "$ROOT/update.sh" "$@" ;;
  doctor) exec "$ROOT/bin/doctor" ;;
  version | -V | --version)
    v=$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$ROOT/plugin/.claude-plugin/plugin.json" | head -n 1)
    echo "ostrakon $v ($(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo 'not a git checkout'))" ;;
  pair) shift; need_bun; load_env; exec bun "$ROOT/server/hub.ts" pair "$@" ;;
  jot)
    shift
    if [ "${1:-}" = --ask ]; then exec "$ROOT/bin/jot-ask"; fi
    need_bun; exec bun "$ROOT/server/jot.ts" "$@" ;;
  hub) shift; need_bun; load_env; exec bun "$ROOT/server/hub.ts" "$@" ;;
  help | -h | --help) usage ;;
  *) echo "ostrakon: unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
