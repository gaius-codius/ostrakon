#!/usr/bin/env bash
# `ostrakon jot --selection [-p <name>]`: saves the text highlighted on the desktop (the primary
# selection) through `ostrakon jot -`, and shows the answer as a notification with the start of the
# text, so you see what was saved. Bind it to a key (README). Never the clipboard on Linux: it is
# often older and unrelated. macOS has no primary selection, so there it takes the clipboard.
set -uo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
has() { command -v "$1" >/dev/null; }

tell() { # title body
  if has notify-send; then notify-send -a ostrakon "$1" "$2"
  elif has osascript; then osascript - "$1" "$2" <<<'on run argv
display notification (item 2 of argv) with title (item 1 of argv)
end run'
  else printf '%s %s\n' "$1" "$2" >&2; fi
}

# The first tool that reads this desktop's selection.
if [ "$(uname -s)" = Darwin ]; then read_selection=(pbpaste)
elif [ -n "${WAYLAND_DISPLAY:-}" ] && has wl-paste; then read_selection=(wl-paste -p -n)
elif has xclip; then read_selection=(xclip -o -selection primary)
elif has xsel; then read_selection=(xsel -p -o)
else
  tell "ostrakon: not saved" "jot --selection needs wl-paste (Wayland), or xclip or xsel (X11)"
  exit 1
fi

# The tools exit non-zero when nothing is selected: the same as an empty selection.
text=$("${read_selection[@]}" 2>/dev/null)
if [ -z "${text//[[:space:]]/}" ]; then
  tell "ostrakon: not saved" "Nothing selected."
  exit 1
fi

# The start of the text on one line, for the notification.
start=$(tr -s '[:space:]' ' ' <<<"$text")
start=${start# }
start=${start% }
[ ${#start} -le 80 ] || start="${start:0:80}…"

if answer=$(printf '%s' "$text" | "$ROOT/bin/ostrakon" jot "$@" - 2>&1); then
  tell ostrakon "$answer
$start"
else
  # The reason without the usage line.
  reason=$(grep -v '^usage:' <<<"$answer")
  tell "ostrakon: not saved" "${reason#ostrakon jot: }"
  exit 1
fi
