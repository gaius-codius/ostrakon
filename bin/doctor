#!/usr/bin/env bash
# shellcheck disable=SC2088,SC2012  # the ~ in messages is meant literally; ls -l only reads one known file
# `ostrakon doctor`: checks that ostrakon is set up and working, and says what to fix. It only
# reads: it changes nothing, and never prints the hub token. Exits 1 if anything needs fixing.
set -uo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# As Claude Code finds its settings: CLAUDE_CONFIG_DIR when set, else ~/.claude. Set but empty,
# Claude Code keeps it as it is, so its settings.json is the one in the working directory.
if [ -z "${CLAUDE_CONFIG_DIR+set}" ]; then SETTINGS=$HOME/.claude/settings.json
elif [ -z "$CLAUDE_CONFIG_DIR" ]; then SETTINGS=$PWD/settings.json
else SETTINGS=$CLAUDE_CONFIG_DIR/settings.json; fi
ENV_FILE=${OSTRAKON_HUB_ENV:-$HOME/.config/ostrakon-hub/env}
problems=0

ok() { printf '  ok  %s\n' "$*"; }
bad() { printf '  !!  %s\n' "$*"; problems=$((problems + 1)); }
note() { printf '  --  %s\n' "$*"; }
has() { command -v "$1" >/dev/null; }
tested() { sed -n "s/^$1=//p" "$ROOT/bin/tested-with"; }
# An http(s) status code for a GET, or 000 when nothing answered. The token goes in on stdin, so it
# never shows in the process list.
status_of() { # url [token]
  if [ -n "${2:-}" ]; then
    printf 'Authorization: Bearer %s\n' "$2" | curl -s -o /dev/null -w '%{http_code}' -m 5 -H @- "$1"
  else
    curl -s -o /dev/null -w '%{http_code}' -m 5 "$1"
  fi
}

version=$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$ROOT/plugin/.claude-plugin/plugin.json" | head -n 1)
echo "ostrakon $version ($(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo 'not a git checkout')) in $ROOT"

# What the settings say, as KEY<tab>value lines: the folders Claude Code loads mods from, the notes
# folder it hands the mod (env.OSTRAKON_DIR), and the plugin's options from the entry the sessions
# read (as ostrakon jot reads them, server/jot.ts; SPEC §9.5).
settings() {
  has python3 || return 0
  python3 -I - "$SETTINGS" <<'EOF'
import json, os, sys
path = sys.argv[1]
# No settings file: nothing set there, so the shell's plugin folders still count.
try:
    s = json.load(open(path)) if os.path.exists(path) else {}
except ValueError:
    print('invalid\tjson'); sys.exit(0)
except OSError:
    print('invalid\tunreadable'); sys.exit(0)
if not isinstance(s, dict):
    print('invalid\tobject'); sys.exit(0)
# A value that isn't an object (a leftover null) counts as empty, so it hides none of the others.
dict_or_empty = lambda v: v if isinstance(v, dict) else {}
env = dict_or_empty(s.get('env'))
# The settings' list goes over the shell's, an empty one included.
dirs = env.get('CLAUDE_CODE_PLUGIN_DIRS')
dirs = dirs if isinstance(dirs, str) else os.environ.get('CLAUDE_CODE_PLUGIN_DIRS', '')
# As Claude Code reads a folder in the list (`:`-separated): a leading ~ is home; a relative one loads nothing.
def is_mod(folder):
    folder = os.path.expanduser(folder)
    if not os.path.isabs(folder):
        return False
    try:
        return dict_or_empty(json.load(open(os.path.join(folder, '.claude-plugin', 'plugin.json')))).get('name') == 'ostrakon'
    except (OSError, ValueError):
        return False
folder = any(d and is_mod(d) for d in dirs.split(':'))
market = bool(dict_or_empty(s.get('enabledPlugins')).get('ostrakon@ostrakon'))
print('dirs\t' + dirs)
print('envDir\t' + str(env.get('OSTRAKON_DIR', '')))
print('market\t' + ('1' if market else ''))
print('folder\t' + ('1' if folder else ''))
# A copy loaded from a folder reads `ostrakon`, then `ostrakon@inline`, and Claude Code then skips an
# installed copy; one installed with `claude plugin install` alone reads `ostrakon@ostrakon`.
names = ('ostrakon@ostrakon',) if market and not folder else ('ostrakon', 'ostrakon@inline')
print('entry\t' + ' then '.join(names))
configs = dict_or_empty(s.get('pluginConfigs'))
entries = [dict_or_empty(dict_or_empty(configs.get(n)).get('options')) for n in names]
text = lambda v: v.strip() if isinstance(v, str) else ''
# The hub's URL and token as a pair, from one entry (as ostrakon jot reads them), so a leftover
# entry's URL never meets another's token; an entry with only a URL still shows the token missing.
hub = next((o for o in entries if text(o.get('hubUrl')) and text(o.get('hubToken'))), None) \
    or next((o for o in entries if text(o.get('hubUrl'))), {})
print('hubUrl\t' + text(hub.get('hubUrl')))
print('hubToken\t' + text(hub.get('hubToken')))
for key in ('notesDir', 'mirrorDir'):
    value = next((o.get(key) for o in entries if o.get(key)), '')
    print(f'{key}\t{value}')
EOF
}
dirs='' envDir='' market='' folder='' entry='' hubUrl='' hubToken='' notesDir='' mirrorDir='' invalid=''
while IFS=$'\t' read -r key value; do
  case $key in dirs | envDir | market | folder | entry | hubUrl | hubToken | notesDir | mirrorDir | invalid) printf -v "$key" '%s' "$value" ;; esac
done < <(settings)
expand() { case $1 in '~') echo "$HOME" ;; '~/'*) echo "$HOME/${1#'~/'}" ;; *) echo "$1" ;; esac; }

echo "== Claude Code"
if has claude; then
  cv=$(claude --version 2>/dev/null | awk '{print $1}')
  if [ "$cv" = "$(tested claude)" ]; then ok "claude $cv, the version this release was tested with"
  else note "claude $cv; this release was tested with $(tested claude). Mods are still changing, so if something breaks, mention your version when you report it"; fi
  if claude plugin validate "$ROOT/plugin" >/dev/null 2>&1; then ok "this Claude Code accepts the mod (claude plugin validate)"
  else bad "claude plugin validate rejects the mod; run it to see why: claude plugin validate $ROOT/plugin"; fi
else
  bad "claude not found: install Claude Code (with mods support)"
fi
if [ "$invalid" = json ]; then
  bad "$SETTINGS isn't valid JSON, so Claude Code can't read it"
elif [ "$invalid" = object ]; then
  bad "$SETTINGS isn't a JSON object, so Claude Code can't read it"
elif [ "$invalid" = unreadable ]; then
  bad "$SETTINGS can't be read (a folder, or no permission)"
elif ! has python3; then
  note "python3 not found, so the settings weren't checked"
else
  if [ -n "$market" ] && [ -n "$folder" ]; then
    bad "the mod is both installed from the marketplace and loaded from a folder (CLAUDE_CODE_PLUGIN_DIRS); sessions use the folder's copy, so its settings come from pluginConfigs $entry, not ostrakon@ostrakon. Keep one: claude plugin uninstall ostrakon@ostrakon, or take the folder out of CLAUDE_CODE_PLUGIN_DIRS"
  elif [ -n "$market" ]; then
    ok "the mod is installed from the marketplace (ostrakon@ostrakon)"
  else
    case $dirs in
      *"$ROOT/plugin"*) ok "the mod loads in every session (CLAUDE_CODE_PLUGIN_DIRS)" ;;
      '') bad "the mod isn't loaded: run $ROOT/install.sh, or start claude with --plugin-dir $ROOT/plugin" ;;
      *) bad "CLAUDE_CODE_PLUGIN_DIRS names other folders ($dirs), not $ROOT/plugin" ;;
    esac
  fi
fi

# The borrowed chords (bin/keybindings.json, the README's): an action with no key in a context
# doesn't work there, and Claude Code's own key runs instead (ctrl+x tab focuses the band). An
# action the person gave another key counts, as install.sh leaves it.
if has python3; then
  python3 -I - "$(dirname "$SETTINGS")/keybindings.json" "$ROOT/bin/keybindings.json" "$ROOT" <<'EOF' || problems=$((problems + 1))
import json, os, sys
path, wanted, root = sys.argv[1], sys.argv[2], sys.argv[3]
want = json.load(open(wanted))
try:
    keys = json.load(open(path)) if os.path.exists(path) else {}
    blocks = keys.get('bindings', []) if isinstance(keys, dict) else None
    assert isinstance(blocks, list)
except (OSError, ValueError, AssertionError):
    print(f"  !!  {path} isn't valid keybindings JSON, so none of ostrakon's keys work")
    sys.exit(1)
# Each missing action once, with the contexts it's missing from.
missing = {}
for context, chords in want.items():
    bound = {k: v for b in blocks if isinstance(b, dict) and b.get('context') == context
             for k, v in (b.get('bindings') if isinstance(b.get('bindings'), dict) else {}).items()}
    for key, action in chords.items():
        if action in bound.values():
            continue
        taken = f": it's bound to {bound[key]}" if bound.get(key) else ''
        missing.setdefault((key, action, taken), []).append(context)
if not missing:
    print(f'  ok  ostrakon\'s keybindings are set ({path})')
    sys.exit(0)
if sum(len(contexts) for contexts in missing.values()) == sum(len(chords) for chords in want.values()):
    print(f'  !!  none of ostrakon\'s keybindings are set in {path}')
else:
    for (key, action, taken), contexts in missing.items():
        print(f'  !!  {key} isn\'t bound to {action} in {", ".join(contexts)}{taken}')
print(f'      to add them: {root}/install.sh --keys, or by hand (README.md, Keybindings)')
sys.exit(1)
EOF
fi

# What the mod itself last saw (plugin/src/report.ts): proof it runs, not just that it validates.
if has python3; then
  echo "== the mod in a session"
  python3 -I - "${OSTRAKON_CACHE:-$HOME/.cache/ostrakon}/report.json" "${cv:-}" <<'EOF' || problems=$((problems + 1))
import json, os, sys
from datetime import datetime, timezone
path, installed = sys.argv[1], sys.argv[2]
if not os.path.exists(path):
    print('  --  no load report yet: start a Claude Code session, then run this again')
    sys.exit(0)
when = lambda text: datetime.fromisoformat(text.replace('Z', '+00:00'))
try:
    r = json.load(open(path))
    loaded = when(r['loadedAt'])
except (ValueError, KeyError):
    print(f'  --  the load report ({path}) is unreadable; the next session writes a new one')
    sys.exit(0)
def ago(t):
    s = int((datetime.now(timezone.utc) - t).total_seconds())
    for size, unit in ((86400, 'day'), (3600, 'hour'), (60, 'minute')):
        if s >= size:
            n = s // size
            return f'{n} {unit}{"s" if n != 1 else ""} ago'
    return 'just now'
claude = r.get('claude') or 'unknown'
print(f'  ok  the mod last loaded {ago(loaded)}, in Claude Code {claude}')
if installed and claude not in ('unknown', installed):
    print(f'  --  you have {installed} now; start a session so the report covers it')
# 'sync' is housekeeping (a cache that wouldn't save); a refusal shows as 'hub' or 'mirror'.
needs_fix = lambda p: p['where'] != 'sync'
problems = r.get('problems', [])
failed = any(needs_fix(p) for p in problems)
for p in problems[-5:]:
    mark = '!!' if needs_fix(p) else '--'
    times = f' ({p["count"]} times, last {ago(when(p["last"]))})' if p['count'] > 1 else ''
    print(f'  {mark}  {p["where"]}: {p["message"]}{times}')
# Only the latest five are shown, but every one kept counts.
older = problems[:-5]
if older:
    serious = sum(needs_fix(p) for p in older)
    fix = f' ({serious} to fix)' if serious else ''
    print(f'  {"!!" if serious else "--"}  and {len(older)} older{fix} in {path}')
if failed:
    print('      for details: start claude with --debug-file /tmp/ostrakon-debug.log, then grep ostrakon in it')
sys.exit(1 if failed else 0)
EOF
fi

echo "== notes"
# The folder the mod picks (plugin/src/store.ts): OSTRAKON_DIR as Claude Code hands it over (the
# settings' env goes over the shell's), else notesDir, else the default. Notes go in its notes/.
root=$(expand "${envDir:-${OSTRAKON_DIR:-${notesDir:-$HOME/.local/share/ostrakon}}}")
dir=${root%/}/notes
if [ -d "$dir" ] && [ -w "$dir" ]; then ok "notes folder $dir ($(find "$dir" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ') notes)"
elif [ -d "$dir" ]; then bad "notes folder $dir isn't writable"
else
  # The mod makes it with mkdir -p: from the nearest folder that exists, which must be writable.
  parent=$(dirname "$dir")
  while [ ! -e "$parent" ]; do parent=$(dirname "$parent"); done
  if [ -d "$parent" ] && [ -w "$parent" ]; then note "notes folder $dir doesn't exist yet; the mod makes it on the first note"
  else bad "notes folder $dir doesn't exist, and the mod can't make it: $parent isn't a writable folder"; fi
fi
if [ -n "$mirrorDir" ]; then
  mirror=$(expand "$mirrorDir")
  if [ -d "$mirror" ]; then ok "mirror folder $mirror"
  else bad "mirror folder $mirror doesn't exist (the mod makes it only if its parent folder does)"; fi
fi

# The port the ostrakon-hub service here listens on (install.sh sets HUB_PORT; the hub's default is 8790).
local_hub_port() {
  local p
  p=$(systemctl --user show ostrakon-hub -p Environment --value 2>/dev/null | tr ' ' '\n' | sed -n 's/^HUB_PORT=//p' | tail -n 1)
  echo "${p:-8790}"
}

echo "== sync with a hub"
if [ -n "$invalid" ]; then
  note "the hub wasn't checked, as the settings can't be read"
elif [ -z "$hubUrl" ]; then
  note "no hubUrl set; fine if you sync through a folder, or not at all"
elif ! has curl; then
  note "curl not found, so the hub wasn't checked"
else
  base=${hubUrl%/}
  health=$(curl -s -m 5 "$base/healthz" || true)
  case $health in
    ok*)
      hv=$(printf '%s' "$health" | awk '{print $2}')
      if [ "$hv" = "$version" ]; then ok "hub answers at $base"
      elif has systemctl && systemctl --user is-active --quiet ostrakon-hub &&
        [ "$(curl -s -m 3 "http://127.0.0.1:$(local_hub_port)/healthz" | awk '$1 == "ok" {print $2}')" = "$hv" ]; then
        note "the hub on this machine runs ${hv:-an older version}, this checkout $version; ostrakon update restarts it"
      else
        host=$(printf '%s' "$base" | sed -E 's#^[a-zA-Z]+://##; s#[:/].*##')
        note "hub at $base runs ${hv:-an older version}, this checkout $version; on $host, run ostrakon update"
      fi
      if [ -z "$hubToken" ]; then bad "no hubToken set, so the hub refuses this machine's notes"
      else
        case $(status_of "$base/api/projects" "$hubToken") in
          200) ok "the hub accepts this machine's token" ;;
          401) bad "the hub refuses this machine's token (hubToken); copy HUB_TOKEN from the hub's env file" ;;
          *) bad "the hub didn't answer a signed-in request properly; check its log" ;;
        esac
      fi ;;
    *) bad "nothing answers at $base: is the hub running, and can this machine reach it (Tailscale connected, proxy up)?" ;;
  esac
fi

PROC=${OSTRAKON_PROC:-/proc}
tilde() { case $1 in "$HOME"/*) echo "~/${1#"$HOME"/}" ;; *) echo "$1" ;; esac; }
# The mount a path is on in a mountinfo file, as "<device> <root> <options>": the topmost one at
# the longest mount point that holds the path. systemd mounts at a path's target, so a symlink
# (a dotfile manager's ~/.config/gh) is followed first.
mount_of() { # mountinfo path
  MOUNT_PATH=$(readlink -f -- "$2" 2>/dev/null || echo "$2") awk '
    function unescape(s) { gsub(/\\040/, " ", s); gsub(/\\011/, "\t", s); gsub(/\\012/, "\n", s); gsub(/\\134/, "\\", s); return s }
    BEGIN { path = ENVIRON["MOUNT_PATH"] }
    { at = unescape($5)
      if ((at == "/" || path == at || index(path, at "/") == 1) && length(at) >= best) { best = length(at); found = $3 " " $4 " " $6 } }
    END { print found }' "$1"
}
# The writable mount points below a folder in a mountinfo file, one per line.
writable_below() { # mountinfo folder
  MOUNT_PATH=$(readlink -f -- "$2" 2>/dev/null || echo "$2") awk '
    function unescape(s) { gsub(/\\040/, " ", s); gsub(/\\011/, "\t", s); gsub(/\\012/, "\n", s); gsub(/\\134/, "\\", s); return s }
    BEGIN { path = ENVIRON["MOUNT_PATH"] }
    { at = unescape($5); if (index(at, path "/") == 1) top[at] = $6 }
    END { for (at in top) if (top[at] ~ /^rw/) print at }' "$1"
}
# What the hub's unit asks for, as systemctl shows it after its drop-ins.
HUB_CONFIG=''
hub_prop() { printf '%s\n' "$HUB_CONFIG" | sed -n "s/^$1=//p"; }
# A list property's paths, one per line, without the - prefix. systemctl quotes a path with a space.
hub_paths() { hub_prop "$1" | xargs -r printf '%s\n' 2>/dev/null | sed 's/^-//'; }
hub_listed() { hub_paths "$1" | grep -qxF -- "$2"; } # property path
# The folder the hub writes: HUB_DATA from the unit's env file (as systemd reads it), else the default.
hub_data() {
  local line value=''
  if [ -r "$ENV_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ $line =~ ^[[:space:]]*HUB_DATA=(.*)$ ]] || continue
      value=${BASH_REMATCH[1]}
      [[ $value =~ ^\"(.*)\"$ || $value =~ ^\'(.*)\'$ ]] && value=${BASH_REMATCH[1]}
    done <"$ENV_FILE"
  fi
  value=${value:-$HOME/.local/share/ostrakon-hub}
  echo "${value%/}"
}

# Whether the hub can write its data folder, from the unit's settings, so it's said even when the
# hub can't start because of it. In your home, only the default and a ReadWritePaths= are writable.
hub_data_writable() {
  local data home entry
  data=$(hub_data) home=$(readlink -f -- "$HOME" 2>/dev/null || echo "$HOME")
  # The hub's own /tmp is emptied on every stop (a home folder there is another matter).
  case $(readlink -m -- "$data")/ in
    "${home%/}"/*) ;;
    /tmp/* | /var/tmp/*) bad "the hub's data folder $data is in /tmp or /var/tmp, which the hub gets a private copy of, emptied on every restart: set HUB_DATA in $ENV_FILE to a folder that lasts"; return ;;
  esac
  [ "$(hub_prop ProtectHome)" = read-only ] || return 0
  case $(readlink -m -- "$data")/ in "${home%/}"/*) ;; *) return 0 ;; esac
  while IFS= read -r entry; do
    case $data/ in "${entry%/}"/*) return 0 ;; esac
  done < <(hub_paths ReadWritePaths)
  bad "the hub can't write its data folder $data (HUB_DATA in $ENV_FILE), as its sandbox keeps your home read-only. Run '$ROOT/install.sh' --hub again: it adds the folder to the unit"
}

# The hub's sandbox (server/ostrakon-hub.service, SPEC §9.2), checked on the running hub itself:
# where the kernel can't apply a limit, systemd turns it off and starts the hub anyway.
hub_sandbox() { # pid
  local at=$PROC/$1 off=() unapplied=() path m family families data default extra
  if [ "${1:-0}" = 0 ] || ! [ -r "$at/mountinfo" ] || ! [ -r "$at/status" ]; then note "couldn't check the hub's sandbox: $at isn't readable"; return; fi
  # Each limit: its name, whether the unit asks for it, and whether the running hub has it.
  limit() { # name configured applied
    if [ "$2" != 1 ]; then off+=("$1"); elif [ "$3" != 1 ]; then unapplied+=("$1"); fi
  }
  is() { "$@" && echo 1; }
  limit ProtectHome=read-only "$(is [ "$(hub_prop ProtectHome)" = read-only ])" \
    "$(is grep -q '^ro' <<<"$(mount_of "$at/mountinfo" "$HOME" | cut -d' ' -f3)")"
  # The paths the unit hides, where they exist here.
  for path in "$HOME/.ssh" "$HOME/.gnupg" "$HOME/.config/gh" "$HOME/.claude" \
    "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" /run/dbus/system_bus_socket /run/docker.sock /run/podman; do
    [ -e "$path" ] || continue
    m=$(mount_of "$at/mountinfo" "$path" | cut -d' ' -f2)
    limit "InaccessiblePaths=$(tilde "$path")" "$(is hub_listed InaccessiblePaths "$path")" "$(is grep -q /inaccessible/ <<<"$m")"
  done
  limit NoNewPrivileges=yes "$(is [ "$(hub_prop NoNewPrivileges)" = yes ])" "$(is grep -qx $'NoNewPrivs:\t1' "$at/status")"
  # Its own /tmp: a different mount there than this process sees.
  limit PrivateTmp=yes "$(is [ "$(hub_prop PrivateTmp)" != no ])" \
    "$(is [ "$(mount_of "$at/mountinfo" /tmp | cut -d' ' -f1,2)" != "$(mount_of "$PROC/self/mountinfo" /tmp | cut -d' ' -f1,2)" ])"
  # Only the three families (or fewer): an allow-list, not a deny-list (~).
  families=$(hub_prop RestrictAddressFamilies)
  m=1
  [[ $families == AF_* ]] || m=''
  for family in $families; do case $family in AF_INET | AF_INET6 | AF_UNIX) ;; *) m='' ;; esac; done
  limit "RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX" "$m" "$(is grep -qx $'Seccomp:\t2' "$at/status")"

  join() { local IFS=, all; all="$*"; echo "${all//,/, }"; }
  if [ ${#off[@]} -gt 0 ]; then
    bad "the hub's unit ($(systemctl --user show ostrakon-hub -p FragmentPath --value 2>/dev/null)) leaves out $(join "${off[@]}") (SPEC §9.2), so the hub can reach more than it needs. Run '$ROOT/install.sh' --hub again: it links the unit from this checkout"
  fi
  if [ ${#unapplied[@]} -gt 0 ]; then
    note "the running hub doesn't have $(join "${unapplied[@]}"). If systemctl --user restart ostrakon-hub doesn't add them, this machine can't apply them (the folder limits need unprivileged user namespaces); the hub works without them"
  fi
  # A ReadWritePaths= of your own, besides the data folder (and the default one), is the hub's to write too.
  data=$(readlink -m -- "$(hub_data)") default=$(readlink -m -- "$HOME/.local/share/ostrakon-hub")
  extra=$(writable_below "$at/mountinfo" "$HOME" | while IFS= read -r m; do
    case $m/ in "$data"/* | "$default"/*) ;; *) tilde "$m" ;; esac
  done | sort | paste -sd, - | sed 's/,/, /g')
  [ -z "$extra" ] || note "besides its data folder, the hub can write $extra (ReadWritePaths= in its unit)"
  [ ${#off[@]} -gt 0 ] || [ ${#unapplied[@]} -gt 0 ] || ok "the hub runs in its sandbox: your home is read-only to it except its data folder, and it can't see ~/.ssh, ~/.gnupg, ~/.config/gh, ~/.claude, your session's sockets or Docker's"
}

# The hub on this machine, if it's set up here.
if has systemctl && systemctl --user cat ostrakon-hub >/dev/null 2>&1; then
  echo "== the hub on this machine"
  # HOME as one spelling (no trailing /), for comparing paths.
  [ "$HOME" = / ] || HOME=${HOME%/}
  HUB_CONFIG=$(systemctl --user show ostrakon-hub -p ProtectHome -p ReadWritePaths -p InaccessiblePaths -p NoNewPrivileges -p PrivateTmp -p RestrictAddressFamilies 2>/dev/null)
  if systemctl --user is-active --quiet ostrakon-hub; then
    ok "the ostrakon-hub service is running"
    hub_sandbox "$(systemctl --user show ostrakon-hub -p MainPID --value 2>/dev/null)"
  else bad "the ostrakon-hub service isn't running: systemctl --user start ostrakon-hub, and journalctl --user -u ostrakon-hub for why"; fi
  hub_data_writable
  if has loginctl && [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]; then
    note "it stops when you log out; to keep it running: loginctl enable-linger $USER"
  fi
  if [ -r "$ENV_FILE" ]; then
    case $(ls -l "$ENV_FILE" | cut -c5-10) in
      ------) ok "$ENV_FILE is readable only by you" ;;
      *) bad "others can read the hub token in $ENV_FILE: chmod 600 $ENV_FILE" ;;
    esac
  fi
  has bun || bad "bun not found; the hub needs it (https://bun.sh)"
  has qrencode || note "qrencode not found; ostrakon pair needs it to show a QR code"
fi

echo "== tools"
if has bun; then
  bv=$(bun --version 2>/dev/null)
  if [ "$bv" = "$(tested bun)" ]; then ok "bun $bv"; else note "bun $bv; tested with $(tested bun)"; fi
else
  note "bun not found; only the hub, ostrakon pair and ostrakon jot need it"
fi
has git || bad "git not found; ostrakon update needs it"
case :$PATH: in
  *:"$HOME/.local/bin":*) ok "~/.local/bin is on your PATH" ;;
  *) note "~/.local/bin isn't on your PATH, so the ostrakon command only works by its full path" ;;
esac

echo
if [ $problems = 0 ]; then echo "All good."; elif [ $problems = 1 ]; then echo "1 thing to fix, marked !! above."; exit 1
